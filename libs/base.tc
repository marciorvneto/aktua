// Useful variables

let s = poly([0, 1])

// Control-specific functions

fn feedback(G, H) {
  G / (1 + G * H)
}

fn pid(kp, ki, kd) {
	kp + ki/s + kd*s
}

// PID with derivative filtering
fn pidf(kp, ki, kd, Tf) {
	kp + ki/s + kd*s / (1 + Tf * s)
}

fn closedloop(G) {
  G / (1 + G)
}

fn stable(G) {
	// Checks if a CT system represented by the
	// transfer function G is stable
	let p = poles(G)
	for i in range(0, len(p)){
		if real(p[i]) > -1e-6 { return 0 }
	}
	1
}

// Useful functions

fn map(f, list){
	let out = []
	for v in list {
		out = push(out, f(v))
	}
	out
}

fn filter(f, list){
	let out = []
	for v in list {
		if f(v) {
			out = push(out, v)
		}
	}
	out
}
