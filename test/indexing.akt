import("test.akt")

let v = [1, 2, 3]
assert_eq(v[0], 1)
assert_eq(v[-1], 3)

// One index per dimension
let A = [1, 2, 3; 4, 5, 6]
assert_eq(A[0, 2], 3)
assert_eq(A[1, 0], 4)
assert_eq(A[1, -3], 4)
assert_eq(A[-1, -1], 6)

// Indices can be expressions
let i = 1
assert_eq(A[i, i + 1], 6)

let t = (7, 8)
assert_eq(t[1], 8)
assert_eq(t[-2], 7)
