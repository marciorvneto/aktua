import("test.akt")
import("base.akt")

let M = [1,2,3,4;
         5,6,7,8]

let Y0 = M[:, 0]
let Y1 = M[:, 1]
let Y2 = M[:, 2]
let Y3 = M[:, 3]

assert_eq(Y0, [1,5])
assert_eq(Y1, [2,6])
assert_eq(Y2, [3,7])
assert_eq(Y3, [4,8])

// Rows, ranges, negative bounds
assert_eq(M[1],       [5,6,7,8])
assert_eq(M[1, 1:3],  [6,7])
assert_eq(M[:, -2:],  [3,4; 7,8])
assert_eq(M[0, :-1],  [1,2,3])
assert_eq(M[1, 2],    7)

// A slice keeps its axis, an index drops it
assert_eq(M[0:1, :].shape, [1, 4])
assert_eq(M[0, :].shape,   [4])
assert_eq(M[:, 2:2].shape, [2, 0])

// Slices are copies
let r = M[0]
r[0]  = 100
assert_eq(M[0, 0], 1)
