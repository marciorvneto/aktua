import("test.akt")

let (x, y) = (1,2)

assert_eq(x, 1)
assert_eq(y, 2)

let (x, y, z) = (1,2,3)

assert_eq(x, 1)
assert_eq(y, 2)
assert_eq(z, 3)

// Swap
let (a, b) = (1, 2)
(a, b) = (b, a)
assert_eq(a, 2)
assert_eq(b, 1)

// From a function
fn minmax(v) { (min(v), max(v)) }
let (lo, hi) = minmax([3, 1, 2])
assert_eq(lo, 1)
assert_eq(hi, 3)

// Fibonacci: the right-hand side is evaluated before anything is bound
let (a, b) = (0, 1)
for i in range(0, 10) { (a, b) = (b, a + b) }
assert_eq(a, 55)

// let in a block shadows, plain assignment updates the outer variable
let c = 1
if true { let (c, d) = (5, 6) }
assert_eq(c, 1)
if true { (a, b) = (7, 8) }
assert_eq(a, 7)

// Unpacked tensors are copies
let t = ([1, 2], 3)
let (h, k) = t
h[0] = 9
assert_eq(t[0][0], 1)
