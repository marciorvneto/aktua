import("test.tc")

// ---------- Sizes ----------

assert(len(linspace(0, 1, 0)) == 0, "zero points gives an empty array")
assert(len(linspace(0, 1, 1)) == 1, "one point")
assert(len(linspace(0, 1, 5)) == 5, "five points")
assert(len(linspace(0, 1, 100000)) == 100000, "large count")

// ---------- Values ----------

let one = linspace(3, 7, 1)
assert(one[0] == 3, "single point is the start")

let basic = linspace(0, 1, 5)
assert(basic[0] == 0, "starts at from")
assert(basic[1] == 0.25, "evenly spaced")
assert(basic[2] == 0.5, "evenly spaced, middle")
assert(basic[4] == 1, "ends at to")

// Fractional endpoints must not be rounded
let frac = linspace(0.5, 2.5, 5)
assert(frac[0] == 0.5, "fractional start")
assert(frac[1] == 1, "fractional spacing")
assert(frac[4] == 2.5, "fractional end")

let small = linspace(0, 0.1, 4)
assert_close(small[1], 0.1 / 3, 1e-15)
assert(small[3] == 0.1, "small range end")

// Decreasing ranges
let down = linspace(1, 0, 3)
assert(down[0] == 1, "decreasing start")
assert(down[1] == 0.5, "decreasing middle")
assert(down[2] == 0, "decreasing end")

// ---------- Exact endpoint ----------

// from + (n - 1) * dx misses the endpoint by one rounding step for these
let e1 = linspace(0, 0.1, 12)
assert(e1[11] == 0.1, "exact endpoint 0.1 with 12 points")
let e2 = linspace(0, 0.3, 38)
assert(e2[37] == 0.3, "exact endpoint 0.3 with 38 points")
let e3 = linspace(0, 0.7, 36)
assert(e3[35] == 0.7, "exact endpoint 0.7 with 36 points")

// ---------- Uniform spacing ----------

let pts  = linspace(-2, 3, 51)
let spacing = 0.1
let prev = pts[0]
let first = 1
for p in pts {
  if first == 0 {
    assert_close(p - prev, spacing, 1e-12)
  }
  first = 0
  prev = p
}
