import("test.akt")
import("orbital")

fn assert_all_close(actual, expected, tol, msg) {
  assert(len(actual) == len(expected), msg + ": lengths differ")
  for i in range(0, len(actual)) {
    assert(abs(actual[i] - expected[i]) < tol, msg + ": element " + i)
  }
}

fn norm(x) { sqrt(sum(x * x)) }
fn energy(r, v, mu) { sum(v * v) / 2 - mu / norm(r) }
fn h_z(r, v) { r[0] * v[1] - r[1] * v[0] }

let mu = 398600.4418
let pi = acos(-1)

// Stumpff functions, both sides of the series cutoff
assert_close(stumpff_s(0), 1 / 6, 1e-15)
assert_close(stumpff_c(0), 1 / 2, 1e-15)
assert_close(stumpff_s(1e-10), 1 / 6 - 1e-10 / 120, 1e-15)
assert_close(stumpff_c(1e-10), 1 / 2 - 1e-10 / 24, 1e-15)

// Just inside and just outside the cutoff, both branches agree with the series
fn s_series(z) { 1 / 6 - z / 120 + z ^ 2 / 5040 - z ^ 3 / 362880 }
fn c_series(z) { 1 / 2 - z / 24 + z ^ 2 / 720 - z ^ 3 / 40320 }
for z in [0.999e-3, 1.001e-3, -0.999e-3, -1.001e-3] {
  assert_close(stumpff_s(z), s_series(z), 1e-12)
  assert_close(stumpff_c(z), c_series(z), 1e-12)
}

// Circular LEO: one full period comes back to the start
let r = 7000
let vc = sqrt(mu / r)
let T = 2 * pi * sqrt(r ^ 3 / mu)
let r0 = [r, 0, 0]
let v0 = [0, vc, 0]

let s = propagate(r0, v0, T, mu)
assert_all_close(s[0], r0, 1e-6, "circular period, r")
assert_all_close(s[1], v0, 1e-9, "circular period, v")

// Quarter period lands on the y axis
let q = propagate(r0, v0, T / 4, mu)
assert_all_close(q[0], [0, r, 0], 1e-6, "circular quarter, r")
assert_all_close(q[1], [-vc, 0, 0], 1e-9, "circular quarter, v")

// dt = 0 is the identity
let z = propagate(r0, v0, 0, mu)
assert_all_close(z[0], r0, 1e-12, "dt = 0, r")
assert_all_close(z[1], v0, 1e-12, "dt = 0, v")

// Elliptic orbit (Curtis, Example 3.7), inputs rounded to 5 digits
let re = [7000, -12124, 0]
let ve = [2.6679, 4.6210, 0]
let se = propagate(re, ve, 3600, mu)
assert_all_close(se[0], [-3297.8, 7413.4, 0], 0.5, "ellipse, r")
assert_all_close(se[1], [-8.2977, -0.96309, 0], 5e-3, "ellipse, v")
assert_close(energy(se[0], se[1], mu), energy(re, ve, mu), 1e-9)
assert_close(h_z(se[0], se[1]), h_z(re, ve), 1e-6)

// Hyperbolic flyby: energy and angular momentum are conserved
let rh = [7000, 0, 0]
let vh = [0, 12, 0]
let sh = propagate(rh, vh, 20000, mu)
assert_true(energy(rh, vh, mu) > 0, "hyperbolic orbit")
assert_close(energy(sh[0], sh[1], mu), energy(rh, vh, mu), 1e-9)
assert_close(h_z(sh[0], sh[1]), h_z(rh, vh), 1e-6)

// Short steps compose: 100 steps of 0.01 s match one 1 s step
let rs = r0
let vs = v0
for i in range(0, 100) {
  let step = propagate(rs, vs, 0.01, mu)
  rs = step[0]
  vs = step[1]
}
let one = propagate(r0, v0, 1, mu)
assert_all_close(rs, one[0], 1e-8, "composed steps, r")
assert_all_close(vs, one[1], 1e-11, "composed steps, v")

// Planar 2-D vectors work too
let p = propagate([r, 0], [0, vc], T / 4, mu)
assert_all_close(p[0], [0, r], 1e-6, "2-D, r")
