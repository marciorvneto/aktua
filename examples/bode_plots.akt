// -----------------------------------------------------
//
//  BODE PLOTS
//  By: Marcio R. V. Neto, 2026
//
//  Frequency response of the leaky tank loop from
//  leaky_tank.akt, closed with the PI controller.
//
// -----------------------------------------------------

let s  = poly([0, 1])
let I  = complex(0, 1)
let pi = 4 * atan(1)

let H = 0.2 / (100 * s + 1)    // Tank: level [m] per inflow [L/s], time constant 100 s
let C = 20 + 0.2 / s           // PI controller
let W = C * H / (1 + C * H)    // Closed loop: level setpoint -> level

let ws = 10 ^ linspace(-4, 1, 201)    // [rad/s]

let MagdB = 20 * log10(abs(W(ws*I)))
let Arg   = arg(W(ws*I)) * 180 / pi    // [deg]

plot(ws, MagdB, xscale="log")
plot(ws, Arg,   yscale="log")
