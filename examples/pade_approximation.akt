// -----------------------------------------------------
//
//  PADE APPROXIMATION
//  By: Marcio R. V. Neto, 2026
//
//  Rational approximations of a dead time exp(-L s),
//  orders 1 and 2, on the leaky tank with L = 20 s.
//
// -----------------------------------------------------

let s  = poly([0, 1])
let I  = complex(0, 1)
let pi = 4 * atan(1)

fn pade1(L) {
  (1 - L*s/2) / (1 + L*s/2)
}

fn pade2(L) {
  let x = L*s
  (1 - x/2 + x^2/12) / (1 + x/2 + x^2/12)
}

let H  = 0.2 / (100*s + 1)
let L  = 20
let P1 = pade1(L)
let P2 = pade2(L)

print(P1)
print(P2)

let H1 = H * P1
let H2 = H * P2

// Both are all-pass, |P(jw)| = 1, so the magnitude matches exp(-L s)
let ws     = 10 ^ linspace(-3, 0, 201)
let Hexact = H(ws*I) * exp(-L*ws*I)
print("Max magnitude error, order 1: " + max(abs(abs(H1(ws*I)) - abs(Hexact))))
plot(log10(ws), abs(Hexact))

// Phase error [deg] vs. exp(-L s)
for w in [0.01, 0.05, 0.1, 0.2] {
  let d = exp(-L*w*I)
  print("w = " + w + ", order 1: " + arg(P1(w*I) / d) * 180 / pi + ", order 2: " + arg(P2(w*I) / d) * 180 / pi)
}

let wp = 10 ^ linspace(-3, log10(0.2), 201)
let d  = exp(-L*wp*I)
plot(wp, arg(P1(wp*I) / d) * 180 / pi)
plot(wp, arg(P2(wp*I) / d) * 180 / pi)

// Step responses: exact (delayed by L), order 1 (zero at s = +1/10), order 2
let t = linspace(0, 150, 301)
plot(t, step(H, t - L))
plot(t, step(H1, t))
plot(t, step(H2, t))
