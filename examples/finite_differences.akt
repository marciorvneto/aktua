// -----------------------------------------------------
//
//  FINITE DIFFERENCES
//  By: Marcio R. V. Neto, 2026
//
//  Differentiation matrices built with diag(),
//  tested on y = sin(t), dy/dt = cos(t).
//
// -----------------------------------------------------

let N    = 200
let t    = linspace(0, 10, N)
let dt   = t[1] - t[0]
let ysin = sin(t)

// Forward difference, (y[i+1] - y[i]) / dt: -1 on the diagonal, +1 above it
print(-eye(5) + diag(ones([4]), 1))

let D = 1/dt * (-eye(N) + diag(ones([N-1]), 1))

// No y[N] for the last row, backward difference there
D[N-1, N-2] = -1/dt
D[N-1, N-1] =  1/dt

let ycos_fwd = D @ ysin
print("Forward, max error:  " + max(abs(ycos_fwd - cos(t))))

// Centered difference, (y[i+1] - y[i-1]) / (2 dt), error ~ dt^2
let Dc = 1/(2*dt) * (diag(ones([N-1]), 1) - diag(ones([N-1]), -1))

// Second-order one-sided rows at both ends
//   first: (-3 y[0] + 4 y[1] - y[2]) / (2 dt)
//   last:  (3 y[N-1] - 4 y[N-2] + y[N-3]) / (2 dt)
Dc[0, 0]     = -3/(2*dt)
Dc[0, 1]     =  4/(2*dt)
Dc[0, 2]     = -1/(2*dt)
Dc[N-1, N-1] =  3/(2*dt)
Dc[N-1, N-2] = -4/(2*dt)
Dc[N-1, N-3] =  1/(2*dt)

let ycos_ctr = Dc @ ysin
print("Centered, max error: " + max(abs(ycos_ctr - cos(t))))

plot(t, ysin)
plot(t, ycos_fwd)
plot(t, ycos_ctr)
