// -----------------------------------------------------
//
//  NEWTON-RAPHSON
//  By: Marcio R. V. Neto, 2026
//
//  Newton-Raphson with a numerical derivative, used
//  for the phase margin of the leaky tank under P control.
//
// -----------------------------------------------------

// Centered difference
fn derivative(f, x, h) {
  (f(x + h) - f(x - h)) / (2 * h)
}

fn nr(f, x0) {
  let x = x0
  for i in range(0, 50) {
    let h  = 1e-6 * (1 + abs(x))
    let dx = f(x) / derivative(f, x, h)
    x = x - dx
    if abs(dx) < 1e-12 * (1 + abs(x)) {
      return x
    }
  }
  print("nr: did not converge")
  x
}

fn to_solve(x) { x * x - 5 }

print("sqrt(5) = " + nr(to_solve, 5))

// Quadratic convergence, the error is squared at each step
let x = 1
for i in range(1, 6) {
  x = x - (x * x - 2) / (2 * x)
  print("sqrt(2), step " + i + ", error " + abs(x - sqrt(2)))
}

// Phase margin. Crossover at |L(jw)| = 1, solved in u = log(w),
// where log|L| is almost linear

let s  = poly([0, 1])
let j  = complex(0, 1)
let pi = 4 * atan(1)

let K   = 0.2
let tau = 100
let kp  = 20
let L   = kp * K / (tau * s + 1)

fn log_gain(u) { log(abs(L(j * exp(u)))) }

let wc = exp(nr(log_gain, 0))
let pm = 180 + arg(L(j * wc)) * 180 / pi

print("wc = " + wc + " rad/s, PM = " + pm + " deg")

// Exact for first order: wc = sqrt((K kp)^2 - 1) / tau
let wc_exact = sqrt((K * kp) ^ 2 - 1) / tau
print("exact: wc = " + wc_exact + " rad/s, PM = " + (180 - atan(tau * wc_exact) * 180 / pi) + " deg")
