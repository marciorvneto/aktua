//
//  A second-order underdamped RLC circuit step response
//  in Aktua
//
// -----------------------------------------------------

let s = poly([0, 1])

let R = 20      // Ohms
let L = 0.01    // H
let C = 10e-6   // F

let H = 1/(L * C) / (s^2 + R/L * s + 1/(L*C))
print(H)

let t = linspace(0, 8e-3, 401) // Plotting for 8ms
let y = step(H, t - 2e-3)
let u = step(1, t - 2e-3)   // The input: a unit step at 2 ms
show(t*1e3, (y,u)) // Plot in ms


