// -----------------------------------------------------
//
//  TANK LEVEL CONTROL
//  By: Marcio R. V. Neto, 2026
//
//  Gravity-drained tank, linearized around its
//  operating point, under P, PI and PID control.
//  Deviation variables: level [m], flow [L/s], time [s].
//
// -----------------------------------------------------

let s = poly([0, 1])

// A dh/dt = q_in - q_out,  q_out = Cv sqrt(h)
// Linearized valve: R = dh/dq_out = 2 h0 / q0
// H(s) = K / (tau s + 1),  K = R,  tau = A R

let A  = 0.5     // Cross-section [m^2]
let h0 = 1       // Operating level [m]
let q0 = 10      // Operating flow [L/s]

let K   = 2 * h0 / q0      // [m per L/s]
let tau = A * 1000 * K     // [s], 1000 L per m^3

let H = K / (tau * s + 1)
print("K = " + K + ", tau = " + tau)
print(poles(H))

let t_open = linspace(0, 500, 251)
plot(t_open, step(H, t_open))

fn closed_loop(C) { C * H / (1 + C * H) }
fn disturbance(C) { H / (1 + C * H) }

// P control. Offset from the final value theorem: W(0) = K kp / (1 + K kp)
for gain in [5, 20, 100] {
  let W = closed_loop(gain)
  print("kp = " + gain + ", W(0) = " + W(0))
}

// PI, lambda tuning: kp = tau / (K lambda), ki = kp / tau
// The PI zero cancels the tank pole, W(s) = 1 / (lambda s + 1)
let lambda = 25
let kp     = tau / (K * lambda)
let ki     = kp / tau
print("kp = " + kp + ", ki = " + ki)

let C_pi = kp + ki / s
let W_pi = closed_loop(C_pi)
print(W_pi)
print(poles(W_pi))

let t = linspace(0, 150, 151)
plot(t, step(W_pi, t))

// Ideal PID. Derivative kick at t = 0: W(inf) = K kd / (tau + K kd)
let kd    = 250
let W_pid = closed_loop(C_pi + kd * s)
print("PID, level at t = 0: " + K * kd / (tau + K * kd))
plot(t, step(W_pid, t))

// Filtered derivative, tf = Td / 10
let tf     = (kd / kp) / 10
let W_pidf = closed_loop(C_pi + kd * s / (tf * s + 1))
plot(t, step(W_pidf, t))

// 1 L/s inflow disturbance. The cancelled tank pole is still in H / (1 + C H)
let t_dist = linspace(0, 400, 201)
print("P, kp = 20, offset: " + step(disturbance(20), t_dist)[-1] + " m")
plot(t_dist, step(disturbance(C_pi), t_dist))
