// -----------------------------------------------------
//
//  SAMPLED TANK
//  By: Marcio R. V. Neto, 2026
//
//  The tank from leaky_tank.akt under a PLC that reads
//  the level every Ts seconds and holds its output.
//  Level [m], flow [L/s], time [s].
//
// -----------------------------------------------------

let s = poly([0, 1])

let K   = 0.2      // [m per L/s]
let tau = 100      // [s]
let H   = K / (tau * s + 1)

// Exact sampled model, zero-order hold:
//   Hd(z) = K (1 - a) / (z - a),  a = exp(-Ts / tau)
// Stable if the poles are inside the unit circle, |z| < 1

let Ts = 10
let z  = zvar(Ts)
let a  = exp(-Ts / tau)
let Hd = K * (1 - a) / (z - a)

print(Hd)

let tk = Ts * linspace(0, 30, 31)
plot(tk, step(Hd, tk), "stairs")

// Approximations of s
//   Forward Euler: s ~ (z - 1) / Ts
//   Tustin:        s ~ (2 / Ts) (z - 1) / (z + 1)

let s_euler  = (z - 1) / Ts
let s_tustin = (2 / Ts) * (z - 1) / (z + 1)

let H_euler  = K / (tau * s_euler + 1)
let H_tustin = K / (tau * s_tustin + 1)

print("Poles, exact / Euler / Tustin:")
print(poles(Hd))
print(poles(H_euler))
print(poles(H_tustin))

// Forward Euler needs Ts < 2 tau. Tustin keeps stable poles stable for any Ts

let Ts_slow = 250
let z_slow  = zvar(Ts_slow)

let H_euler_slow  = K / (tau * (z_slow - 1) / Ts_slow + 1)
let H_tustin_slow = K / (tau * (2 / Ts_slow) * (z_slow - 1) / (z_slow + 1) + 1)

print("Ts = " + Ts_slow + " s, poles, Euler / Tustin:")
print(poles(H_euler_slow))
print(poles(H_tustin_slow))

let t_slow = Ts_slow * linspace(0, 12, 13)
plot(t_slow, step(H_euler_slow, t_slow), "stairs")

// Digital PI, same gains as leaky_tank.akt
//   1/s ~ Ts z / (z - 1)

let kp = 20
let ki = 0.2

let C  = kp + ki / s
let Cd = kp + ki * Ts * z / (z - 1)

let W  = C * H / (1 + C * H)
let Wd = Cd * Hd / (1 + Cd * Hd)

print(Wd)
print(poles(Wd))

let t = linspace(0, 150, 151)
plot(t, step(W, t))
plot(t, step(Wd, t), "stairs")
