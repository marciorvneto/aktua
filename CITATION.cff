repository-code: "https://github.com/marciorvneto/aktua"
url: "https://aktua.dev"
license: MIT
keywords:
  - control systems
  - programming language
  - transfer functions
  - LTI systems
  - numerical computing
version: "0.1.0"
date-released: "2026-11-07"
