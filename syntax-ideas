PROGRAM         = STATEMENTS_LIST
                | eof

STATEMENTS_LIST = STATEMENT STATEMENTS_LIST
                | eps

STATEMENT       = ASSIGNMENT     STMT_END
                | RETURN_STMT    STMT_END
                | BREAK_STMT     STMT_END
                | CONTINUE_STMT  STMT_END
                | FOR_STMT       STMT_END
                | WHILE_STMT     STMT_END
                | FUNCTION_DEF   STMT_END
                | IF_STATEMENT   STMT_END
                | EXPRESSION     STMT_END

FOR_STMT        = "for" id "in" EXPRESSION BLOCK

WHILE_STMT      = "while" EXPRESSION BLOCK

RETURN_STMT     = "return" EXPRESSION
                | "return"

BREAK_STMT      = "break"

CONTINUE_STMT   = "continue"

STMT_END        = "\n"
                | eof
                | &"}"

ASSIGNMENT      = "let" id "=" EXPRESSION
                | id "=" EXPRESSION
                | id "[" ARGS_LIST "]" = EXPRESSION

IF_STATEMENT    = "if" EXPRESSION BLOCK ELIF_LIST ELSE_OPT

ELIF_LIST       = "elif" EXPRESSION BLOCK ELIF_LIST
                | eps

ELSE_OPT        = "else" BLOCK
                | eps

FUNCTION_DEF    = "fn" id "(" PARAMS ")" BLOCK

PARAMS          = id
                | PARAMS, id
                | eps

BLOCK           = "{" STATEMENTS_LIST "}"

EXPRESSION      = ADDITIVE COMPOP ADDITIVE
                | ADDITIVE

COMPOP          = ==
                | <=
                | >=
                | > 
                | < 

ADDITIVE        = TERM + ADDITIVE
                | TERM + ADDITIVE
                | TERM

TERM            = UNARY * TERM
                | UNARY / TERM
                | UNARY

UNARY           = "+" UNARY
                | "-" UNARY
                | EXPO

EXPO            = POSTFIX ^ UNARY
                | POSTFIX

POSTFIX         = PRIMARY POSTFIX_TAIL

POSTFIX_TAIL    = "." id POSTFIX_TAIL
                | eps

PRIMARY         = number
                | id "(" ARGS_LIST ")"
                | id "(" ")"
                | INDEXING
                | id
                | '"' + char* + '"'
                | ARRAY
                | TUPLE
                | "(" EXPRESSION ")"

ARRAY           = "[" "]"
                | "[" ROW ARRAY_TAIL "]"

ARRAY_TAIL      = ";" ROW ARRAY_TAIL
                | eps

ROW             = EXPRESSION ROW_TAIL

ROW_TAIL        = "," EXPRESSION ROW_TAIL
                | eps

INDEXING        = id "[" ARGS_LIST "]"

ARGS_LIST       = EXPRESSION ARGS_LIST_TAIL

ARGS_LIST_TAIL  = "," EXPRESSION ARGS_LIST_TAIL
                | eps

TUPLE           = "(" EXPRESSION "," TUPLE_TAIL ")"

TUPLE_TAIL      = EXPRESSION TUPLE_REST
                | eps

TUPLE_REST      = "," TUPLE_TAIL
                | eps
