PROGRAM            = STATEMENTS_LIST
                   | eof

STATEMENTS_LIST    = STATEMENT STATEMENTS_LIST
                   | eps

STATEMENT          = DECLARATION    STMT_END
                   | ASSIGNMENT     STMT_END
                   | RETURN_STMT    STMT_END
                   | BREAK_STMT     STMT_END
                   | CONTINUE_STMT  STMT_END
                   | FOR_STMT       STMT_END
                   | WHILE_STMT     STMT_END
                   | FUNCTION_DEF   STMT_END
                   | IF_STATEMENT   STMT_END
                   | EXPRESSION     STMT_END

FOR_STMT           = "for" id "in" EXPRESSION BLOCK

WHILE_STMT         = "while" EXPRESSION BLOCK

RETURN_STMT        = "return" EXPRESSION
                   | "return"

BREAK_STMT         = "break"

CONTINUE_STMT      = "continue"

STMT_END           = "\n"
                   | eof
                   | &"}"

DECLARATION        = "let" TARGET "=" EXPRESSION

ASSIGNMENT         = LVALUE ASSIGN_OP EXPRESSION
                   | UNPACK "=" EXPRESSION

TARGET             = id
							     | UNPACK

UNPACK             = "(" id "," id UNPACK_TAIL ")"

UNPACK_TAIL        = "," id UNPACK_TAIL
								   | eps

ASSIGN_OP          = "="
                   | "+="
                   | "-="
                   | "*="
                   | "/="
                   | "%="
                   | "^="

LVALUE             = id "[" ARGS_LIST "]"
                   | id

IF_STATEMENT       = "if" EXPRESSION BLOCK ELIF_LIST ELSE_OPT

ELIF_LIST          = "elif" EXPRESSION BLOCK ELIF_LIST
                   | eps

ELSE_OPT           = "else" BLOCK
                   | eps

FUNCTION_DEF       = "fn" id "(" PARAMS ")" BLOCK

PARAMS             = PARAM PARAMS_TAIL
                   | eps

PARAMS_TAIL        = "," PARAM PARAMS_TAIL
                   | eps

PARAM              = id "=" EXPRESSION
                   | id

BLOCK              = "{" STATEMENTS_LIST "}"

EXPRESSION         = OR_EXPR

OR_EXPR            = AND_EXPR "or" OR_EXPR
                   | AND_EXPR

AND_EXPR           = NOT_EXPR "and" AND_EXPR
                   | NOT_EXPR

NOT_EXPR           = "not" NOT_EXPR
                   | COMPARISON

COMPARISON         = ADDITIVE COMPOP ADDITIVE
                   | ADDITIVE

COMPOP             = ==
                   | <=
                   | >=
                   | > 
                   | < 

ADDITIVE           = TERM + ADDITIVE
                   | TERM - ADDITIVE
                   | TERM

TERM               = UNARY * TERM
                   | UNARY / TERM
                   | UNARY % TERM
                   | UNARY

UNARY              = "+"   UNARY
                   | "-"   UNARY
                   | EXPO

EXPO               = POSTFIX ^ UNARY
                   | POSTFIX

POSTFIX            = PRIMARY POSTFIX_TAIL

POSTFIX_TAIL       = "." id POSTFIX_TAIL
                   | "[" ARGS_LIST "]" POSTFIX_TAIL
                   | eps

PRIMARY            = number
                   | BOOLEAN
                   | id "(" CALL_ARGS_LIST ")"
                   | id "(" ")"
                   | id
                   | '"' + char* + '"'
                   | ARRAY
                   | TUPLE
                   | "(" EXPRESSION ")"

CALL_ARGS_LIST     = CALL_ARG CALL_ARGS_TAIL
                   | eps

CALL_ARGS_TAIL     = "," CALL_ARG CALL_ARGS_TAIL
                   | eps

CALL_ARG           = id "=" EXPRESSION
                   | EXPRESSION

BOOLEAN            = true
                   | false

ARRAY              = "[" "]"
                   | "[" ROW ARRAY_TAIL "]"

ARRAY_TAIL         = ";" ROW ARRAY_TAIL
                   | eps

ROW                = EXPRESSION ROW_TAIL

ROW_TAIL           = "," EXPRESSION ROW_TAIL
                   | eps

ARGS_LIST          = EXPRESSION ARGS_LIST_TAIL

ARGS_LIST_TAIL     = "," EXPRESSION ARGS_LIST_TAIL
                   | eps

TUPLE              = "(" EXPRESSION "," TUPLE_TAIL ")"

TUPLE_TAIL         = EXPRESSION TUPLE_REST
                   | eps

TUPLE_REST         = "," TUPLE_TAIL
                   | eps
